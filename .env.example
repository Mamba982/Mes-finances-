# Copier vers .env.local (jamais commité). Les valeurs NEXT_PUBLIC_* sont visibles dans le navigateur.

# Supabase : Réglages du projet > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secrets serveur (Vercel > Settings > Environment Variables). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# IA (facultative, éteinte) : laisser vide. Sans clé, aucune requête ne part vers Anthropic
# et l'application fonctionne entièrement avec le classement par règles.
ANTHROPIC_API_KEY=
# Modèles Claude : ANTHROPIC_MODEL lit les relevés, images et reçus et répond à l'assistant (claude-sonnet-5-5) ;
# ANTHROPIC_MODEL_RAPIDE classe les transactions (claude-haiku-5-5)
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_RAPIDE=
# Nombre de requêtes IA permises par utilisateur et par jour
IA_LIMITE_QUOTIDIENNE=30

# Courriels (passage au public) : SMTP Brevo, vide pour l'instant = envoi intégré de Supabase.
# Appliqué par : node --env-file=.env.local scripts/configurer-courriels.mjs
SMTP_HOTE=
SMTP_PORT=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR_COURRIEL=
SMTP_EXPEDITEUR_NOM=Mes finances
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=clnldhyrizlwwizniivq

# Tests RLS : Postgres local (voir scripts/db-test.sh)
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:54329/mes_finances_test

# Essais contre la vraie API (npm run test:ia) : adresse du déploiement qui porte la clé
IA_URL=
